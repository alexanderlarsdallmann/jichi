index c701cbf..cdcc6dc 100644
--- a/src/core/variant/variant.zig
+++ b/src/core/variant/variant.zig
@@ -137,6 +137,14 @@ pub const Vector2 = struct {
     pub fn init(x: f32, y: f32) Vector2 {
         return .{ .x = x, .y = y };
     }
+
+    /// Linear interpolation between two Vector2 values
+    pub fn lerp(self: Vector2, to: Vector2, weight: f32) Vector2 {
+        return Vector2{
+            .x = self.x + (to.x - self.x) * weight,
+            .y = self.y + (to.y - self.y) * weight,
+        };
+    }
 };
 
