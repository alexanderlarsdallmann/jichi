+// --- the gate for docs/assignments/vector-interpolation-for-keyframes-interpolate.md
+//
+// Spec-specific on purpose (2026-08-13): the verify is
+// `zig build test -Dtest-filter='interpolate vectors'`, so this assignment is
+// decoupled from its siblings' gates -- the coupling lesson from the ping-pong
+// campaign, applied. Red today because interpolate() returns `from` unchanged
+// for vector tags; green on a correct component-wise implementation.
+test "keyframes.interpolate vectors (assignment gate): vector2 midpoint" {
+    const variant = @import("../core/variant/index.zig");
+    const from = variant.Variant{ .vector2 = .{ .x = 1.0, .y = 2.0 } };
+    const to = variant.Variant{ .vector2 = .{ .x = 3.0, .y = 6.0 } };
+    const mid = keyframes.interpolate(from, to, 0.5);
+    try testing.expect(mid == .vector2);
+    try testing.expectApproxEqAbs(@as(f32, 2.0), mid.vector2.x, 0.0001);
+    try testing.expectApproxEqAbs(@as(f32, 4.0), mid.vector2.y, 0.0001);
+}
+
+test "keyframes.interpolate vectors (assignment gate): vector3 at t=0.3" {
+    const variant = @import("../core/variant/index.zig");
+    const from = variant.Variant{ .vector3 = .{ .x = 0.0, .y = 0.0, .z = 0.0 } };
+    const to = variant.Variant{ .vector3 = .{ .x = 10.0, .y = 20.0, .z = 30.0 } };
+    const at = keyframes.interpolate(from, to, 0.3);
+    try testing.expect(at == .vector3);
+    try testing.expectApproxEqAbs(@as(f32, 3.0), at.vector3.x, 0.0001);
+    try testing.expectApproxEqAbs(@as(f32, 6.0), at.vector3.y, 0.0001);
+    try testing.expectApproxEqAbs(@as(f32, 9.0), at.vector3.z, 0.0001);
+}
+
+test "keyframes.interpolate vectors (assignment gate): unknown tags still pass through" {
+    const variant = @import("../core/variant/index.zig");
+    const from = variant.Variant{ .nil = {} };
+    const out = keyframes.interpolate(from, from, 0.5);
+    try testing.expect(out == .nil);
+}
