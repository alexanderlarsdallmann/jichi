+test "evaluator.pingpongWrap: simple bounce (assignment gate)" {
+    const evaluator = @import("evaluator.zig");
+    const res = evaluator.pingpongWrap(1.1, 1.0);
+    try testing.expectApproxEqAbs(@as(f32, 0.9), res.wrapped_time, 0.0001);
+    try testing.expect(res.reversed == true);
+}
+
+test "evaluator.pingpongWrap: deep bounce (assignment gate)" {
+    const evaluator = @import("evaluator.zig");
+    const res = evaluator.pingpongWrap(2.1, 1.0);
+    try testing.expectApproxEqAbs(@as(f32, 0.1), res.wrapped_time, 0.0001);
+    try testing.expect(res.reversed == false);
+}
+
+test "evaluator.pingpongWrap: boundaries (assignment gate)" {
+    const evaluator = @import("evaluator.zig");
+    const res0 = evaluator.pingpongWrap(0.0, 1.0);
+    try testing.expectApproxEqAbs(@as(f32, 0.0), res0.wrapped_time, 0.0001);
+    try testing.expect(res0.reversed == false);
+
+    const res1 = evaluator.pingpongWrap(1.0, 1.0);
+    try testing.expectApproxEqAbs(@as(f32, 1.0), res1.wrapped_time, 0.0001);
+    // reversed at exactly t == length is unspecified by the assignment; only
+    // the wrapped value is gated here.
+}
