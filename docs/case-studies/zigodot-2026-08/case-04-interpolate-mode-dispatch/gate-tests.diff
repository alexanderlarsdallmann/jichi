+
+// --- the gate for docs/assignments/interpolate-value-dispatch.md ------------
+//
+// Red today: interpolateWithMode @panic's. Green on a correct dispatch.
+// (An earlier draft of this gate constructed an AnimationEvaluator and thereby
+// discovered the evaluator struct has NEVER compiled when used -- its
+// std.HashMap field predates the current 4-argument API, and no test had ever
+// instantiated the type. gate-lint counts test blocks, not analyzable types;
+// the first constructing test is what found it. The dispatch is therefore
+// gated as the pure function the evaluator will later delegate to.)
+test "keyframes.interpolateWithMode (assignment gate): nearest snaps" {
+    const variant = @import("../core/variant/index.zig");
+    const a = variant.Variant{ .float = 1.0 };
+    const b = variant.Variant{ .float = 9.0 };
+    const early = keyframes.interpolateWithMode(a, b, 0.4, .nearest);
+    const late = keyframes.interpolateWithMode(a, b, 0.6, .nearest);
+    try testing.expectApproxEqAbs(@as(f64, 1.0), early.float, 0.0001);
+    try testing.expectApproxEqAbs(@as(f64, 9.0), late.float, 0.0001);
+}
+
+test "keyframes.interpolateWithMode (assignment gate): linear delegates" {
+    const variant = @import("../core/variant/index.zig");
+    const a = variant.Variant{ .float = 0.0 };
+    const b = variant.Variant{ .float = 100.0 };
+    const mid = keyframes.interpolateWithMode(a, b, 0.5, .linear);
+    try testing.expectApproxEqAbs(@as(f64, 50.0), mid.float, 0.0001);
+}
+
+test "keyframes.interpolateWithMode (assignment gate): cubic falls back to linear" {
+    const variant = @import("../core/variant/index.zig");
+    const a = variant.Variant{ .float = 0.0 };
+    const b = variant.Variant{ .float = 10.0 };
+    const at = keyframes.interpolateWithMode(a, b, 0.25, .cubic);
+    try testing.expectApproxEqAbs(@as(f64, 2.5), at.float, 0.0001);
+}
