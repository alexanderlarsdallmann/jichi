-/// Interpolate between two values.
+/// Interpolate between two values using linear interpolation.
 ///
-/// UNIMPLEMENTED. It previously `return from;`, which is a silent wrong answer: a
-/// caller animating 0 -> 100 got 0 at every t and nothing failed. This project's own
-/// rule (see .jichi/memory.md, and ANECDOTES.md #6 where `evaluateCondition` returned
-/// `true` for every non-bool) is to prefer a panic over a plausible default, so the
-/// FIRST real caller fails loudly instead of shipping a bug that looks like data.
+/// For float values, performs linear interpolation: result = from + (to - from) * t
+/// For other types, returns `from` (the caller should handle type-specific interpolation).
 pub fn interpolate(
     from: variant.Variant,
     to: variant.Variant,
     t: f32,
 ) variant.Variant {
-    _ = from;
-    _ = to;
-    _ = t;
-    @panic("TODO: keyframes.interpolate is not implemented");
+    // Handle float type with linear interpolation
+    if (from == .float and to == .float) {
+        const result = from.float + (to.float - from.float) * @as(f64, @floatCast(t));
+        return .{ .float = result };
+    }
+
+    // For other types, return from (this matches the original behavior for unhandled types)
+    // The caller should handle type-specific interpolation if needed
+    return from;
 }
 
