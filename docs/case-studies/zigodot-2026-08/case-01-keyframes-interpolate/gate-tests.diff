+// --- the gate for docs/assignments/implementation-keyframes-interpolate.md ---
+//
+// Added 2026-08-12 to make that assignment's `verify` TWO-SIDED. As authored, its
+// gate was `zig build test`, which was already green -- keyframes.interpolate
+// panics and nothing called it, so `jichi grade` reported PASS at 100% before any
+// work was done. A gate that cannot be red is not a gate (docs/ANECDOTES.md, and
+// jichi's own docs/TEST_INTEGRITY.md).
+//
+// These two tests fail today with the TODO panic and pass on a correct
+// implementation. They assert only what the assignment states: linear
+// interpolation of a float, and nearest picking an endpoint.
+test "keyframes.interpolate: linear on floats (assignment gate)" {
+    const a = keyframes.Keyframe{ .time = 0.0, .value = .{ .float = 0.0 } };
+    const b = keyframes.Keyframe{ .time = 1.0, .value = .{ .float = 100.0 } };
+    const mid = keyframes.interpolate(a.value, b.value, 0.5);
+    try testing.expect(mid == .float);
+    try testing.expectApproxEqAbs(@as(f64, 50.0), mid.float, 0.0001);
+}
+
+test "keyframes.interpolate: endpoints are exact (assignment gate)" {
+    const variant = @import("../core/variant/index.zig");
+    const from = variant.Variant{ .float = 7.0 };
+    const to = variant.Variant{ .float = 9.0 };
+    const at0 = keyframes.interpolate(from, to, 0.0);
+    const at1 = keyframes.interpolate(from, to, 1.0);
+    try testing.expectApproxEqAbs(@as(f64, 7.0), at0.float, 0.0001);
+    try testing.expectApproxEqAbs(@as(f64, 9.0), at1.float, 0.0001);
+}
